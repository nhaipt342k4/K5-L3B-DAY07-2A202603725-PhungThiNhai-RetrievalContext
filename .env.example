# Copy to .env and fill in. Never commit .env.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash-lite
# Optional: disable/limit "thinking" tokens (none|low|medium|high)
LLM_REASONING_EFFORT=
# Paid-tier reference price used only for the cost estimate (USD per 1M tokens)
LLM_PRICE_IN_PER_M=0.30
LLM_PRICE_OUT_PER_M=2.50
# Seconds between LLM calls (free-tier rate limit)
LLM_MIN_INTERVAL_S=4
# Path to the Day 6 starter folder (holds chroma_db/) if not next to this repo
# DAY6_STARTER=

# ---- Provider: gemini (mặc định) hoặc openai ----
LLM_PROVIDER=gemini
# ---- OpenAI (chỉ dùng khi LLM_PROVIDER=openai) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Giá USD / 1M token (gpt-4.1-mini) để ước tính chi phí
OPENAI_PRICE_IN_PER_M=0.40
OPENAI_PRICE_OUT_PER_M=1.60
